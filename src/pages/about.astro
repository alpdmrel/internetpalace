---
import Base from '../layouts/Base.astro';
import { site, experience, education, skills } from '../data/site';
---

<Base
  title="About"
  description={`${site.role} in ${site.location} — motor control, low-power sensing, PCB design and the manufacturing processes behind them.`}
>
  <div class="wrap head">
    <p class="eyebrow">About</p>
    <h1>{site.name}</h1>
    <p class="lede">
      Electrical and electronics engineer working across hardware design, mechanical design and
      manufacturing. I am most useful in the gap between them — the point where a schematic has
      to become something a production line can actually build.
    </p>

    <ul class="contact">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.github} rel="me noopener">github.com/alpdmrel</a></li>
      <li>{site.location}</li>
    </ul>
  </div>

  <section class="wrap block">
    <p class="eyebrow">Experience</p>
    {
      experience.map((job) => (
        <article class="job">
          <div class="job-head">
            <div>
              <h2>{job.role}</h2>
              <p class="company">
                {job.company} · {job.location}
              </p>
            </div>
            <span class="mono period">{job.period}</span>
          </div>
          <div class:list={['job-body', { 'has-image': 'image' in job }]}>
            <ul>
              {job.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            {'image' in job && (
              <figure class="job-figure">
                <img
                  src={job.image.src}
                  alt={job.image.alt}
                  width="800"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{job.image.caption}</figcaption>
              </figure>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <section class="wrap block">
    <p class="eyebrow">Skills</p>
    <div class="skills">
      {
        skills.map((s) => (
          <div class="skill-group">
            <h3>{s.group}</h3>
            <ul class="tags">
              {s.items.map((i) => (
                <li class="tag">{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap block">
    <p class="eyebrow">Education</p>
    {
      education.map((e) => (
        <div class="edu">
          <div>
            <h2>{e.degree}</h2>
            <p class="company">
              {e.school} · {e.location}
            </p>
          </div>
          <span class="mono period">{e.period}</span>
        </div>
      ))
    }
    <p class="note">
      My senior design project — an autonomous controller for hydroponic growing systems — is
      written up in full, thesis included, over on the
      <a href="/projects/hydroponic-automation">projects page</a>.
    </p>
  </section>

  <section class="wrap block cta-block">
    <h2>Get in touch</h2>
    <p>
      If you are working on motor control, sensing hardware, or moving a product from prototype
      into production, I would be glad to talk.
    </p>
    <p class="cta">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn" href={site.github} rel="noopener">GitHub</a>
    </p>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .lede {
    max-width: 62ch;
    color: var(--text-dim);
    margin-top: 1rem;
    font-size: 1.06rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .block {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  .job {
    padding-top: 1.75rem;
    margin-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .job:first-of-type {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  .job-head,
  .edu {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .job h2,
  .edu h2 {
    font-size: 1.25rem;
  }

  .company {
    color: var(--accent);
    font-size: 0.92rem;
    margin-top: 0.2rem;
  }

  .period {
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .job-body {
    margin-top: 1.1rem;
  }

  .job ul {
    padding-left: 1.15rem;
    display: grid;
    gap: 0.55rem;
    color: var(--text-dim);
    font-size: 0.96rem;
    margin: 0;
  }

  .job-figure {
    margin: 1.5rem 0 0;
  }

  .job-figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .job-figure figcaption {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-faint);
    line-height: 1.5;
  }

  /* Side-by-side once there is room; the photo is square so it reads best
     capped rather than stretched to the column. */
  @media (min-width: 860px) {
    .job-body.has-image {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 290px);
      gap: 2rem;
      align-items: start;
    }

    .job-body.has-image .job-figure {
      margin-top: 0;
    }
  }

  .job li::marker {
    color: var(--accent-dim);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.75rem 2.5rem;
  }

  .skill-group h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .note {
    margin-top: 1.5rem;
    color: var(--text-dim);
    font-size: 0.96rem;
    max-width: 62ch;
  }

  .cta-block {
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .cta-block p {
    color: var(--text-dim);
    max-width: 55ch;
    margin-top: 0.7rem;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
