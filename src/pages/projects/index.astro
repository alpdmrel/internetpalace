---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const groups = [
  {
    key: 'shipped',
    title: 'Built and running',
    blurb: 'Installed, in daily use, and no longer something I think about.',
  },
  {
    key: 'active',
    title: 'In progress',
    blurb: 'Being designed or assembled right now.',
  },
  {
    key: 'research',
    title: 'Research & academic',
    blurb: 'Written work, with the full documents attached.',
  },
  {
    key: 'on-hold',
    title: 'Designed, parked',
    blurb:
      'Worked out on paper but not built — usually because something needed measuring first, or a dependency moved.',
  },
  {
    key: 'archived',
    title: 'Superseded',
    blurb: 'Replaced by a later revision. Kept because the reasoning still holds up.',
  },
] as const;

const byStatus = groups
  .map((g) => ({ ...g, items: all.filter((p) => p.data.status === g.key) }))
  .filter((g) => g.items.length > 0);
---

<Base
  title="Projects"
  description="Hardware, embedded and home-automation projects — architecture, control logic and the design decisions behind each build."
>
  <div class="wrap head">
    <p class="eyebrow">Index</p>
    <h1>Projects</h1>
    <p class="lede">
      Twenty builds, from a one-relay switch to a controller that runs a hydroponic system on
      its own. Each is written up for the reasoning — the constraint that set the design, what
      I picked, and the failure mode I was designing against.
    </p>

    <nav class="jump" aria-label="Jump to section">
      {
        byStatus.map((g) => (
          <a href={`#${g.key}`}>
            {g.title} <span>{g.items.length}</span>
          </a>
        ))
      }
    </nav>
  </div>

  {
    byStatus.map((g) => (
      <section class="wrap group" id={g.key}>
        <div class="group-head">
          <h2>{g.title}</h2>
          <p>{g.blurb}</p>
        </div>
        <div class="grid">
          {g.items.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .lede {
    max-width: 62ch;
    color: var(--text-dim);
    margin-top: 1rem;
    font-size: 1.03rem;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .jump span {
    color: var(--text-faint);
    font-size: 0.68rem;
  }

  .group {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    scroll-margin-top: 90px;
  }

  .group-head {
    margin-bottom: 1.6rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .group-head p {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-top: 0.4rem;
    max-width: 62ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }
</style>
