---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, experience } from '../data/site';

const all = await getCollection('projects');
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const recent = all
  .filter((p) => !p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const shipped = all.filter((p) => p.data.status === 'shipped').length;
const current = experience[0];
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{site.location} · Available for hardware work</p>
      <h1>{site.tagline}</h1>
      <div class="lede">
        {site.intro.map((p) => <p>{p}</p>)}
      </div>

      <div class="cta">
        <a class="btn btn-primary" href="/projects">Browse projects</a>
        <a class="btn" href="/about">Experience &amp; skills</a>
      </div>

      <dl class="stats">
        <div>
          <dt>Projects documented</dt>
          <dd>{all.length}</dd>
        </div>
        <div>
          <dt>Built &amp; running</dt>
          <dd>{shipped}</dd>
        </div>
        <div>
          <dt>Currently</dt>
          <dd class="small">{current.role}<br /><span>{current.company}</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="wrap block">
    <p class="eyebrow">Selected work</p>
    <h2>The ones worth reading first</h2>
    <div class="featured">
      {featured.map((p) => <ProjectCard project={p} feature />)}
    </div>
  </section>

  <section class="wrap block">
    <p class="eyebrow">More projects</p>
    <h2>Everything else</h2>
    <div class="grid">
      {recent.map((p) => <ProjectCard project={p} />)}
    </div>
    <p class="more">
      <a class="btn" href="/projects">All {all.length} projects →</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) 1rem;
  }

  h1 {
    max-width: 18ch;
    margin-bottom: 1.75rem;
  }

  .lede {
    max-width: 64ch;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-dim);
    font-size: 1.05rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    margin-top: 3.5rem;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .stats > div {
    background: var(--surface);
    padding: 1.1rem 1.25rem;
  }

  .stats dt {
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .stats dd {
    margin: 0.35rem 0 0;
    font-size: 1.9rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stats dd.small {
    font-size: 0.92rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .stats dd.small span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .block {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .block h2 {
    margin-bottom: 1.75rem;
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .more {
    margin-top: 2rem;
  }
</style>
