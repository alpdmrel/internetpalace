---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Featured cards get a larger, wider treatment. */
  feature?: boolean;
}

const { project, feature = false } = Astro.props;
const d = project.data;
---

<article class:list={['card', { feature }]}>
  <div class="top">
    <span class="badge" data-status={d.status}>{d.status.replace('-', ' ')}</span>
    <span class="mono">{d.year} · {d.domain}</span>
  </div>

  <h3>
    <a href={`/projects/${project.id}`}>{d.title}</a>
  </h3>

  <p class="tagline">{d.tagline}</p>

  {
    feature && d.highlights.length > 0 && (
      <ul class="points">
        {d.highlights.slice(0, 3).map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }

  <ul class="tags">
    {d.tech.slice(0, feature ? 7 : 4).map((t) => <li class="tag">{t}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.3rem 1.4rem 1.4rem;
    transition: border-color 0.18s, transform 0.18s;
    /* Accent rule that fills in on hover — a small signal that the whole card
       is a link without needing a chevron. */
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.25s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card:hover::before,
  .card:focus-within::before {
    transform: scaleY(1);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .top .mono {
    font-size: 0.68rem;
  }

  h3 {
    font-size: 1.2rem;
    letter-spacing: -0.015em;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  /* Whole card is the hit target, but only the title is the real link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h3 a {
    color: var(--accent);
  }

  .tagline {
    color: var(--text-dim);
    font-size: 0.93rem;
    line-height: 1.55;
    flex: 1;
  }

  .points {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .points li {
    position: relative;
    padding-left: 1.1rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-dim);
  }

  .tags {
    margin-top: 0.2rem;
  }

  .card.feature {
    padding: 1.75rem 1.9rem 1.9rem;
    gap: 0.85rem;
  }

  .card.feature h3 {
    font-size: 1.6rem;
  }

  .card.feature .tagline {
    font-size: 1.02rem;
    flex: 0;
  }
</style>
