---
/**
 * The thesis block diagrams, redrawn in English.
 *
 * The originals are Turkish screenshots on hard black backgrounds. These are
 * generated by scripts/build_diagrams.py and inlined here rather than loaded
 * as <img>, so the CSS variables below cascade into them and the diagrams
 * follow the site theme.
 */
import system from '../diagrams/system.svg?raw';
import unit1 from '../diagrams/unit1.svg?raw';
import unit2 from '../diagrams/unit2.svg?raw';
import unit3 from '../diagrams/unit3.svg?raw';
import light from '../diagrams/light.svg?raw';

const diagrams = [
  {
    svg: system,
    number: 1,
    title: 'System architecture',
    explanation: `Four field nodes report over the LAN to a Raspberry Pi 4 that holds the
      database, the automations and the interface. Measurement lives at the edge and control
      lives centrally, so a single node dropping off costs one measurement rather than the
      whole loop — and the control logic can be changed without reflashing anything in the
      grow room.`,
  },
  {
    svg: unit1,
    number: 3,
    title: 'Unit 1 — sensing',
    explanation: `Everything the controller measures. Water level by both float switches and
      ultrasonic ranging, flow rate, pH, TDS, turbidity, two leak detectors, and two separate
      temperature and humidity sensors over I²C. The lid switch matters more than it looks:
      it tells the system when someone has the enclosure open.`,
  },
  {
    svg: unit2,
    number: 6,
    title: 'Unit 2 — actuation',
    explanation: `Everything the controller can move. Four dosing pumps handle pH up, pH down
      and the two nutrient concentrates; the main and circulation pumps move water; the
      solenoid valve tops the tank up from mains. High- and low-voltage relays are kept on
      separate banks.`,
  },
  {
    svg: unit3,
    number: 7,
    title: 'Unit 3 — lighting',
    explanation: `Grow and panel lamps dimmed by PWM through TIP122 Darlingtons. Driving the
      lights on a duty cycle rather than switching them fully on gives control over delivered
      light without burning the difference off as heat in a series resistor.`,
  },
  {
    svg: light,
    number: 8,
    title: 'Light measurement',
    explanation: `A separate node measuring what actually reaches the canopy — ultraviolet,
      illuminance, and colour temperature. This is what closes the loop on Unit 3: without it
      the system knows the lamp is on, but not what the plants are receiving.`,
  },
];
---

<section class="diagrams" aria-labelledby="diagrams-heading">
  <p class="eyebrow">Redrawn from the thesis</p>
  <h2 id="diagrams-heading">System diagrams</h2>
  <p class="intro">
    The original diagrams were drawn in Turkish. These are redrawn in English, and are live
    SVG rather than screenshots — so they stay sharp at any zoom and follow the page theme.
  </p>

  <ol class="list">
    {
      diagrams.map((d) => (
        <li class="item">
          <figure>
            <div class="canvas" set:html={d.svg} />
            <figcaption>
              <p class="label mono">Figure {d.number}</p>
              <h3>{d.title}</h3>
              <p class="explain">{d.explanation}</p>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .diagrams {
    /* Consumed by the inlined SVGs. */
    --dg-text: var(--text);
    --dg-muted: var(--text-faint);
    --dg-wire: #55606e;
    --dg-neutral-fill: var(--surface-2);
    --dg-neutral-stroke: var(--border-strong);
    --dg-sensor-fill: rgba(94, 209, 138, 0.13);
    --dg-sensor-stroke: #5ed18a;
    --dg-act-fill: rgba(255, 159, 69, 0.13);
    --dg-act-stroke: #ff9f45;
    --dg-mcu-fill: rgba(94, 200, 242, 0.13);
    --dg-mcu-stroke: #5ec8f2;
    --dg-ctrl-fill: rgba(167, 139, 250, 0.16);
    --dg-ctrl-stroke: #a78bfa;
    --dg-font: var(--font-sans);
    --dg-mono: var(--font-mono);

    margin-top: 4.5rem;
  }

  :global(html[data-theme='light']) .diagrams {
    --dg-wire: #98a1ad;
    --dg-sensor-fill: rgba(43, 122, 75, 0.1);
    --dg-sensor-stroke: #2b7a4b;
    --dg-act-fill: rgba(184, 100, 26, 0.1);
    --dg-act-stroke: #b8641a;
    --dg-mcu-fill: rgba(26, 127, 168, 0.1);
    --dg-mcu-stroke: #1a7fa8;
    --dg-ctrl-fill: rgba(109, 78, 199, 0.12);
    --dg-ctrl-stroke: #6d4ec7;
  }

  .intro {
    color: var(--text-dim);
    max-width: 62ch;
    margin-top: 0.75rem;
  }

  .list {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  figure {
    margin: 0;
  }

  .canvas {
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    /* Wide diagrams scroll inside their own box rather than the page. */
    overflow-x: auto;
  }

  .canvas :global(svg) {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
  }

  figcaption {
    margin-top: 1rem;
  }

  .label {
    color: var(--accent);
    font-size: 0.68rem;
  }

  figcaption h3 {
    font-size: 1.1rem;
    margin-top: 0.3rem;
  }

  .explain {
    color: var(--text-dim);
    font-size: 0.96rem;
    margin-top: 0.5rem;
    max-width: 68ch;
  }
</style>
